{
  "name": "agentic-bot-defense-cdk",
  "version": "1.0.0",
  "description": "AWS WAF Bot Control + Lambda@Edge + Amazon Rekognition Face Liveness step-up challenge for agent-driven browser sessions",
  "private": true,
  "license": "MIT-0",
  "scripts": {
    "build": "tsc --noEmit",
    "build:web": "npm --prefix ../web/challenge ci && npm --prefix ../web/challenge run build",
    "test": "node --test test/*.test.js && tsx --test test/*.test.ts",
    "synth": "cdk synth",
    "smoke": "node scripts/smoke-test.mjs",
    "diagram": "node ../docs/build-diagram.mjs && rsvg-convert -z 2 ../docs/architecture.svg -o ../docs/architecture.png",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "2.273.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1151.0",
    "@aws-sdk/client-rekognition": "3.1151.0",
    "@aws-sdk/client-secrets-manager": "3.1151.0",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1145.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
